# =====================================================================
# CONFIGURACIÓN DEL MICROSERVICIO - SYNC MANTENIMIENTOS
# =====================================================================
# Configuración para CRM Cotel con tabla dispositivos
# =====================================================================

# =====================================================================
# SERVICIO
# =====================================================================
SERVICE_NAME=Sync Mantenimientos Service
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8001
DEBUG=true

# =====================================================================
# LOGGING
# =====================================================================
LOG_LEVEL=INFO
LOG_FILE=app/logs/sync_mantenimientos.log

# =====================================================================
# CRM API - CRM COTEL
# =====================================================================
CRM_BASE_URL=https://crmcotel.com.co
CRM_CLIENT_ID=cd031831-d1f0-0a8b-b0a0-69123cd994f5
CRM_CLIENT_SECRET=Api.v8*
CRM_TIMEOUT=30

# =====================================================================
# CRM API - ENDPOINTS (CRM COTEL)
# =====================================================================
# ⚠️ IMPORTANTE: Estos son los endpoints correctos para CRM Cotel
# 
# Autenticación: /crm/Api/access_token
# Mantenimientos: /crm/Api/V8/custom/IA/equipos-info (requiere POST con seriales)
#
# NO CAMBIAR estos valores a menos que el CRM cambie su API
# =====================================================================

CRM_SERVICES_ENDPOINT=/crm/Api/V8/custom/IA/equipos-info

# =====================================================================
# API BASE DE DATOS (POSTGREST)
# =====================================================================
DB_API_BASE_URL=https://api-bd-eficiencia-energetica-853514779938.us-central1.run.app
DB_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYXBpX2NydWRfbW9uaXRvcmVvX2VxdWlwb3MiLCJleHAiOjE3NTEzMzQ3MjAwfQ.k17feSqkWCD8lmddcPRMvYcjogxdvcdKOHrXhRElm04
DB_API_SCHEMA=monitoreo_equipos

# =====================================================================
# DISPOSITIVOS CONFIG
# =====================================================================
# Tipo de dispositivo a filtrar de la tabla dispositivos
# La tabla monitoreo_equipos.dispositivos se usa como fuente de seriales
# Campo filtro: device_type
# Campo serial: serial_number_device
#
# Valores comunes:
#   - Cooling Device (aires acondicionados / CRAC)
#   - Heating Device (calentadores)
#   - Other Device (otros)
#
# Puedes ver todos los tipos disponibles en: GET /dispositivos/types
# =====================================================================

# =====================================================================
# SYNC CONFIG
# =====================================================================
BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY=5

# =====================================================================
# NOTAS IMPORTANTES
# =====================================================================
# 
# 1. CRM_CLIENT_ID y CRM_CLIENT_SECRET son OBLIGATORIOS.
# 2. DB_API_BASE_URL y DB_API_TOKEN son OBLIGATORIOS.
# 3. El CRM Cotel usa un flujo de autenticación y consulta específico.
# 4. FLUJO DE SINCRONIZACIÓN:
#    a. Consulta la API de BD para obtener seriales de la tabla 'dispositivos'.
#    b. Filtra por 'device_type' (ej: Cooling Device).
#    c. Consulta el CRM con los seriales obtenidos.
#    d. Compara con los mantenimientos existentes en la BD (vía API).
#    e. Inserta solo los registros nuevos en la tabla 'mantenimientos' (vía API).
# 5. Las tablas 'dispositivos' y 'mantenimientos' deben ser accesibles a través de la API.
# 6. Se recomienda crear las funciones RPC en la BD para las consultas de agregación.
#
# =====================================================================

# =====================================================================
# FLUJO COMPLETO DE SINCRONIZACIÓN
# =====================================================================
#
# 1. Verificar conexión con la API de la base de datos.
# 2. Consultar API de BD para obtener seriales de la tabla 'dispositivos':
#    GET /dispositivos?select=serial_number_device&device_type=eq.Cooling%20Device
# 3. Autenticarse en CRM Cotel.
# 4. Consultar mantenimientos en el CRM:
#    POST /crm/Api/V8/custom/IA/equipos-info
#    Body: {"seriales": ["SN001", "SN002", ...]}
# 5. Insertar los nuevos mantenimientos en la tabla 'mantenimientos' vía API:
#    POST /mantenimientos
#
# =====================================================================